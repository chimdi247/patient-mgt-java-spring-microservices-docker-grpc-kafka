  {
   "id": 6,
   "type": "stat",
   "title": "Cache hit ratio",
   "description": "Share of block reads served from shared buffers. Healthy OLTP workloads are > 99 %.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 3,
    "x": 12,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 * sum(rate(pg_stat_database_blks_hit{datname=~\"$db\"}[$__range])) / (sum(rate(pg_stat_database_blks_hit{datname=~\"$db\"}[$__range])) + sum(rate(pg_stat_database_blks_read{datname=~\"$db\"}[$__range])))",
     "legendFormat": "",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 90
       },
       {
        "color": "green",
        "value": 99
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "decimals": 2
