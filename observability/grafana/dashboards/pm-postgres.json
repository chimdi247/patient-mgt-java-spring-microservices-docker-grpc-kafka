  "list": [
   {
    "name": "db",
    "label": "Database",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "includeAll": true,
    "multi": true,
    "allValue": ".+",
    "refresh": 2,
    "sort": 1,
    "query": {
     "query": "label_values(pg_stat_database_numbackends{datname=~\"auth_db|patient_db\"}, datname)",
