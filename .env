# =============================================================================
# Patient Management platform - docker compose configuration (docker compose reads .env automatically)
# =============================================================================

# ---- Postgres (one instance, two databases: auth_db and patient_db)

POSTGRES_USER=pm_admin
POSTGRES_PASSWORD=pm_local_password

# ---- JWT signing key: BASE64 of at least 32 random bytes (the auth-service base64-decodes it).
# Shared by auth-service. Generate your own:  openssl rand -base64 64

JWT_SECRET=

# ---- Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ---- Grafana-managed alerts: SMTP server + recipients (CPU / memory > 50 %, Postgres, Kafka alerts)
# Default: the bundled Mailpit container (alert e-mails show up at http://localhost:8025)

#SMTP_HOST=mailpit
#SMTP_PORT=1025
#SMTP_USER=
#SMTP_PASSWORD=

SMTP_FROM_ADDRESS=chimdi247@gmail.com

# NoStartTLS | OpportunisticStartTLS | MandatoryStartTLS
SMTP_STARTTLS_POLICY=NoStartTLS
# comma / semicolon separated list

ALERT_EMAIL_TO=shimdi247@gmail.com
# Real SMTP example (Gmail app password):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=chimdi247@gmail.com
SMTP_PASSWORD=
SMTP_STARTTLS_POLICY=MandatoryStartTLS

# ---- Frontend links (shown on the admin "System" page; baked in at build time)
VITE_GRAFANA_URL=http://34.171.152.81:3001
VITE_KAFKA_UI_URL=http://34.171.152.81:8090
VITE_MAILPIT_URL=http://34.171.152.81:8025
